# ShaadiLens — PRODUCTION settings for the server.
# deploy/bootstrap.sh copies this to /opt/shaadilens/.env (chmod 600, owner deploy) and fills every
# "generated" secret with random values. YOU edit the lines marked CHANGE_ME:
#     sudo -u deploy nano /opt/shaadilens/.env
# Never commit the real file. Never paste its contents into chats, issues or logs.

# --- Public address (Caddy gets a Let's Encrypt certificate for DOMAIN) ---
DOMAIN=CHANGE_ME.duckdns.org
# Let's Encrypt sends certificate-expiry warnings here (optional but recommended)
ACME_EMAIL=CHANGE_ME@example.com
PUBLIC_BASE_URL=https://${DOMAIN}

# --- DuckDNS (keeps DOMAIN pointing at this server's IP; cron every 5 min) ---
# DUCKDNS_SUBDOMAIN is only the first part: "shaadilens" for shaadilens.duckdns.org
DUCKDNS_SUBDOMAIN=CHANGE_ME
DUCKDNS_TOKEN=CHANGE_ME

# --- Admin login at /admin ---
ADMIN_EMAIL=CHANGE_ME@example.com
# Choose a long password (16+ characters). Only you need to know it.
ADMIN_PASSWORD=CHANGE_ME

# --- Secrets (generated by bootstrap.sh; don't change after the first start) ---
# POSTGRES_PASSWORD is applied only when the database volume is first created.
POSTGRES_DB=shaadilens
POSTGRES_USER=shaadilens
POSTGRES_PASSWORD=GENERATED
JWT_SECRET=GENERATED
MEDIA_SIGNING_KEY=GENERATED

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
STORAGE_ROOT=/data/photos
FACE_SERVICE_URL=http://face-service:8000
MAX_UPLOAD_MB=50

# --- CPU tuning (2 OCPU Ampere A1; raise if the VM gets more cores) ---
# Parallel face-detection jobs, threads per detection, and cores the reel (video) worker may use.
FACE_WORKERS=2
FACE_OMP_THREADS=2
REEL_CPUS=1
FACE_DET_SIZE=640
FACE_MAX_SIDE=1600

# --- Notifications (optional; leave empty to turn off) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# --- Hot-folder uploader (optional; 24+ random chars, empty = off) ---
UPLOADER_API_KEY=
