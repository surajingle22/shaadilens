# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_DB=shaadilens
POSTGRES_USER=shaadilens
POSTGRES_PASSWORD=change-me

# --- API ---
# Development = Swagger UI enabled at /swagger. Use Production at the venue.
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_ROOT=/data/photos
FACE_SERVICE_URL=http://face-service:8000

# Used from Phase 1 onwards
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
JWT_SECRET=replace-with-64-random-chars
MEDIA_SIGNING_KEY=replace-with-64-random-chars
FACE_WORKERS=3

# --- face-service ---
FACE_DET_SIZE=640
FACE_MAX_SIDE=1600
FACE_OMP_THREADS=4

# --- web ---
WEB_PORT=8080

# --- Notifications (Phase 2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com
