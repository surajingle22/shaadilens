# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_DB=shaadilens
POSTGRES_USER=shaadilens
POSTGRES_PASSWORD=change-me

# --- API ---
# Development = Swagger UI enabled at /swagger. Use Production at the venue.
ASPNETCORE_ENVIRONMENT=Development
PUBLIC_BASE_URL=http://localhost:8080
STORAGE_ROOT=/data/photos
FACE_SERVICE_URL=http://face-service:8000

# Admin login at /admin (single account)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
# Secrets: 64 random characters each. PowerShell one-liner:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=replace-with-64-random-chars
MEDIA_SIGNING_KEY=replace-with-64-random-chars
# Parallel face-detection jobs. ~3 suits a 4-core laptop.
FACE_WORKERS=3
# CPU cores the reel (video) worker may use. Each guest reel takes ~1 min at 2 cores.
REEL_CPUS=2
MAX_UPLOAD_MB=50

# --- face-service ---
FACE_DET_SIZE=640
FACE_MAX_SIDE=1600
FACE_OMP_THREADS=4

# --- web ---
WEB_PORT=8080

# --- Notifications (optional; leave empty to turn off) ---
# Gmail: SMTP_USER=you@gmail.com, SMTP_PASS=an App Password (Google account → Security → App passwords)
# VAPID: admin → Settings → "Generate VAPID keys", paste both lines here, then: docker compose up -d api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# --- Hot-folder uploader (tools/HotFolderUploader) ---
# Any random string of 24+ characters; leave empty to switch the uploader off.
UPLOADER_API_KEY=
